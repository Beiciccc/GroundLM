__pycache__/
*.pyc
.DS_Store

# Large GPU-extraction caches (~165MB each, >GitHub's 100MB limit).
# Regenerate with: bash reproduce.sh extract   (needs an A100). The small result
# JSONs in runs/ ARE tracked, so the CPU analysis/figures are reproducible.
runs/**/features.npz
*.npz
# ...but the 120 KB parametric-belief caches ARE released (App. "Parametric-belief check").
!runs/*_v2/parametric_belief.npz
*.npz.meta.json
# SummaC sentence-NLI checkpoint cache (rebuilt by scripts/nli_sentence_ragtruth.py)
runs/_nli_sent_cache/

# LaTeX build artifacts
paper/*.aux
paper/*.bbl
paper/*.blg
paper/*.log
paper/*.out
paper/*.fdb_latexmk
paper/*.fls
paper/*.synctex.gz

# submitted supplement archive (kept on disk, not in VCS)
groundlm_supplementary.zip
*.zip

# local analysis virtualenv
.venv/
venv/

# internal working documents, not part of the release
DESIGN_DOC.md
paper/REVIEWER_RISK_NOTES.md
*.bak
runs/results_summary.txt
runs/*.log
errors-main.json

# stray root-level LaTeX log from a failed root-relative build
/main.log

# personal deployment helper for a rented GPU box; not needed to reproduce anything
deploy/remote.py

# ACL PubCheck output
errors-main*.json
errors-main*.png
paper/main-*_*.png

# scratch output of scripts/generate_bib.py (references.bib is hand-maintained)
paper/references.bib.generated
